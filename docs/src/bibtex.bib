
@article{bruce_feedback-enhanced_2015,
	title = {Feedback-enhanced algorithm for aberration correction of holographic atom traps},
	volume = {48},
	issn = {0953-4075},
	url = {https://doi.org/10.1088/0953-4075/48/11/115303},
	doi = {10.1088/0953-4075/48/11/115303},
	abstract = {We show that a phase-only spatial light modulator can be used to generate non-trivial light distributions suitable for trapping ultracold atoms, when the hologram calculation is included within a simple and robust feedback loop that corrects for imperfect device response and optical aberrations. This correction reduces the discrepancy between target and experimental light distribution to the level of a few percent (root mean square error). We prove the generality of this algorithm by applying it to a variety of target light distributions of relevance for cold atomic physics.},
	language = {en},
	number = {11},
	urldate = {2026-02-13},
	journal = {Journal of Physics B: Atomic, Molecular and Optical Physics},
	author = {Bruce, Graham D and Johnson, Matthew Y H and Cormack, Edward and Richards, David A W and Mayoh, James and Cassettari, Donatella},
	month = may,
	year = {2015},
	note = {Publisher: IOP Publishing},
	pages = {115303},
	file = {IOP Full Text PDF:/Users/arnaudarbouet/Zotero/storage/Z8BZDDIV/Bruce et al. - 2015 - Feedback-enhanced algorithm for aberration correction of holographic atom traps.pdf:application/pdf},
}


@article{mendoza-yero_encoding_2014,
	title = {Encoding complex fields by using a phase-only optical element},
	copyright = {© 2014 Optical Society of America},
	url = {https://opg.optica.org/ol/abstract.cfm?uri=ol-39-7-1740},
	doi = {10.1364/OL.39.001740},
	abstract = {We show that the amplitude and phase information from a two-dimensional complex field can be synthesized from a phase-only optical element with micrometric resolution. The principle of the method is based on the combination of two spatially sampled phase elements by using a low-pass filter at the Fourier plane of a 4\&\#x2212;f optical system. The proposed encoding technique was theoretically demonstrated, as well as experimentally validated with the help of a phase-only spatial light modulator for phase encoding, a conventional CMOS camera to measure the amplitude of the complex field, and a Shack\&\#x2013;Hartmann wavefront sensor to determine its phase.},
	language = {EN},
	urldate = {2026-01-09},
	journal = {Optics Letters, Vol. 39, Issue 7, pp. 1740-1743},
	author = {Mendoza-Yero, Omel and Mínguez-Vega, Gladys and Lancis, Jesús},
	month = apr,
	year = {2014},
	note = {Publisher: Optica Publishing Group},
	keywords = {Spatial light modulators, Optical elements, Optical systems, Liquid crystal on silicon, Spatial resolution, CMOS cameras},
}

@article{bowman_high-fidelity_2017,
	title = {High-fidelity phase and amplitude control of phase-only computer generated holograms using conjugate gradient minimisation},
	volume = {25},
	issn = {1094-4087},
	url = {https://opg.optica.org/oe/abstract.cfm?uri=oe-25-10-11692},
	doi = {10.1364/OE.25.011692},
	abstract = {We demonstrate simultaneous control of both the phase and amplitude of light using a conjugate gradient minimisation-based hologram calculation technique and a single phase-only spatial light modulator (SLM). A cost function, which incorporates the inner product of the light field with a chosen target field within a defined measure region, is efficiently minimised to create high fidelity patterns in the Fourier plane of the SLM. A fidelity of F = 0.999997 is achieved for a pattern resembling an LG10 mode with a calculated light-usage efficiency of 41.5\&\#x00025;. Possible applications of our method in optical trapping and ultracold atoms are presented and we show uncorrected experimental realisation of our patterns with F = 0.97 and 7.8\&\#x00025; light efficiency.},
	language = {EN},
	number = {10},
	urldate = {2026-01-19},
	journal = {Optics Express},
	author = {Bowman, D. and Harte, T. L. and Chardonnet, V. and Groot, C. De and Denny, S. J. and Goc, G. Le and Anderson, M. and Ireland, P. and Cassettari, D. and Bruce, G. D.},
	month = may,
	year = {2017},
	note = {Publisher: Optica Publishing Group},
	keywords = {Diffractive optical elements, Fourier transforms, Optical trapping, Optical vortices, Phase modulation, Spatial light modulators},
	pages = {11692--11700},
	file = {Full Text PDF:/Users/arnaudarbouet/Zotero/storage/YUG6AZGQ/Bowman et al. - 2017 - High-fidelity phase and amplitude control of phase-only computer generated holograms using conjugate.pdf:application/pdf},
}


@article{davis_encoding_2003,
	title = {Encoding amplitude and phase information onto a binary phase-only spatial light modulator},
	volume = {42},
	copyright = {© 2003 Optical Society of America},
	issn = {2155-3165},
	url = {https://opg.optica.org/ao/abstract.cfm?uri=ao-42-11-2003},
	doi = {10.1364/AO.42.002003},
	abstract = {We report what to our knowledge is a new technique for encoding both amplitude and phase information onto a single binary-valued spatial light modulator. In our approach, we spatially modulate the diffraction efficiency of the filter. Light that is not diffracted into the first order is sent into the zero order, effectively allowing amplitude modulation of either the first-order or zero-order diffracted light. This technique has applications in both optical pattern recognition and image processing. Experimental results are included.},
	language = {EN},
	number = {11},
	urldate = {2026-02-13},
	journal = {Applied Optics},
	author = {Davis, Jeffrey A. and Valadéz, Keevin Olea and Cottrell, Don M.},
	month = apr,
	year = {2003},
	note = {Publisher: Optica Publishing Group},
	keywords = {Diffraction efficiency, Diffractive optical elements, Fourier transforms, Pattern recognition, Phase shift, Spatial light modulators},
	pages = {2003--2008},
}

@article{tao_beam_2015,
	title = {Beam shaping of complex amplitude with separate constraints on the output beam},
	volume = {23},
	copyright = {\&\#169; 2015 Optical Society of America},
	issn = {1094-4087},
	url = {https://opg.optica.org/oe/abstract.cfm?uri=oe-23-2-1052},
	doi = {10.1364/OE.23.001052},
	abstract = {We present a beam shaping technique in controlling the complex amplitude of an optical beam. The constraint on the amplitude of the output beam in the Gerchberg-Saxton algorithm is replaced with constraints both on the amplitude and phase of the output beam in the proposed method. The total areas of the constrained regions and free regions on the complex amplitude of the output beam in the proposed method are maintained. An output beam with arbitrary complex amplitude can be realized with the proposed method. The computing result from the proposed method is a phase-only distribution, which can be fabricated as diffractive optical element for higher diffraction efficiency. Both simulations and experiments are present and the effectiveness of the proposed method is verified.},
	language = {EN},
	number = {2},
	urldate = {2025-11-18},
	journal = {Optics Express},
	author = {Tao, Shaohua and Yu, Weixing},
	month = jan,
