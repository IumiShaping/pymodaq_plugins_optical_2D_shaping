	pages = {2176--2190},
	file = {Full Text PDF:/Users/arnaudarbouet/Zotero/storage/TUX3QAN7/Pasienski and DeMarco - 2008 - A high-accuracy algorithm for designing arbitrary holographic atom traps.pdf:application/pdf},
