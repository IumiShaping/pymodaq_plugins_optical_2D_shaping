	note = {Publisher: American Chemical Society},
	pages = {3215--3224},
	file = {Full Text PDF:/Users/arnaudarbouet/Zotero/storage/CVIII8L5/Madan et al. - 2022 - Ultrafast Transverse Modulation of Free Electrons .pdf:application/pdf},
}


